<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerSkeleton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/standard_16"
    android:layout_marginTop="@dimen/standard_12"
    android:duration="2000">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/standard_4"
        app:cardCornerRadius="@dimen/standard_20"
        app:cardElevation="@dimen/standard_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/standard_160">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/skeleton_bg"/>

                <View
                    android:layout_width="@dimen/standard_22"
                    android:layout_height="@dimen/standard_22"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/standard_10"
                    android:background="@drawable/skeleton_bg_circle"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/standard_12">

                <View
                    android:layout_width="@dimen/standard_70"
                    android:layout_height="@dimen/standard_14"
                    android:background="@drawable/skeleton_bg"
                    android:layout_marginBottom="@dimen/standard_8"/>

                <View
                    android:layout_width="@dimen/standard_40"
                    android:layout_height="@dimen/standard_12"
                    android:background="@drawable/skeleton_bg"/>
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</com.facebook.shimmer.ShimmerFrameLayout>
